{
  "name": "specguard-ai",
  "version": "0.2.0",
  "description": "SpecGuard \u2014 Living Specification QA agent CLI + MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "specguard": "dist/cli/index.js",
    "specguard-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "specguard",
    "living-specification",
    "qa",
    "testing",
    "playwright",
    "ai",
    "mcp",
    "accessibility",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazzmind/specguard.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "schemas": "node scripts/export-schemas.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@modelcontextprotocol/sdk": "^1",
    "ai": "^7.0.127",
    "commander": "^13",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4",
    "typescript": "^5.7",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/jazzmind/specguard#readme",
  "bugs": {
    "url": "https://github.com/jazzmind/specguard/issues"
  }
}
