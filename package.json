{
  "name": "specguard-ai",
  "version": "0.1.2",
  "description": "SpecGuard — Living Specification QA agent CLI + MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "specguard": "dist/cli/index.js",
    "specguard-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "specguard",
    "living-specification",
    "qa",
    "testing",
    "playwright",
    "ai",
    "mcp",
    "accessibility",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazzmind/specguard.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@modelcontextprotocol/sdk": "^1",
    "ai": "^7.0.127",
    "commander": "^13",
    "fast-xml-parser": "^5.11.2",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^4.1.11"
  }
}
