{
  "name": "specguard-ai",
  "version": "0.1.2",
  "description": "SpecGuard — Living Specification QA agent CLI + MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "specguard": "dist/cli/index.js",
    "specguard-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "specguard",
    "living-specification",
    "qa",
    "testing",
    "playwright",
    "ai",
    "mcp",
    "accessibility",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazzmind/specguard.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ai": "^4",
    "@ai-sdk/anthropic": "^1",
    "@ai-sdk/openai": "^1",
    "zod": "^3",
    "fast-glob": "^3",
    "commander": "^13",
    "@modelcontextprotocol/sdk": "^1"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "vitest": "^3",
    "@types/node": "^22",
    "tsx": "^4"
  }
}
