{
  "apps": [
    {
      "id": "specguard",
      "name": "SpecGuard Team Server",
      "description": "Shared proof, documents and remediation plans for every project that publishes to it. Optional: SpecGuard works fully without it.",
      "source_type": "local",
      "local_folder": ".",
      "dockerfile": "deploy/sandbox/Dockerfile",
      "port": 4317,
      "path_prefix": "/specguard",
      "health_endpoint": "/specguard/api/v1/health",
      "memory_limit": "1g",
      "sync_capable": false,
      "env_vars": {
        "DATABASE_URL": "{{DK_DB_URL}}",
        "SPECGUARD_BASE_PATH": "/specguard",
        "SPECGUARD_ALLOWED_DOMAIN": "plymouthrock.com",
        "SPECGUARD_LLM_PROVIDER": "litellm",
        "SPECGUARD_LLM_MODEL": "fast",
        "SPECGUARD_LLM_BASE_URL": "http://litellm:4000",
        "LITELLM_API_KEY": "",
        "SPECGUARD_BOOTSTRAP_TOKEN": "",
        "SPECGUARD_ADMIN_EMAILS": "",
        "SPECGUARD_MAINTAINER_EMAILS": "",
        "SPECGUARD_GITHUB_REPOS": "",
        "GITHUB_TOKEN": "",
        "HTTPS_PROXY": ""
      }
    }
  ]
}
