{
  "plugins": [
    "quality",
    "git",
    "feature-catalog",
    "contract-mappings"
  ],
  "_comment": "SpecGuard configured to build SpecGuard: one app, functional capability specs under specs/",
  "apps": [
    {
      "name": "specguard",
      "repo": ".",
      "specDir": "specs",
      "sources": {
        "routes": [
          "src/**/*.ts",
          "extension/src/**/*.{ts,tsx}",
          "action/**/*.mjs"
        ],
        "tests": [
          "tests/**/*.test.ts"
        ]
      },
      "framework": "vitest",
      "testOutput": "tests/",
      "security": {
        "enabled": false
      },
      "docs": false,
      "test": {
        "command": "node node_modules/vitest/vitest.mjs run",
        "reporter": "vitest"
      }
    }
  ],
  "runners": {
    "playwright": "local",
    "semgrep": "docker",
    "testRunner": "local"
  },
  "llm": {
    "provider": "anthropic",
    "model": "claude-sonnet-5-5",
    "apiKeyEnv": "ANTHROPIC_API_KEY"
  },
  "triggers": {
    "onPlanPhase": true,
    "onSecurityFiles": [
      "**/auth/**",
      "**/middleware/**"
    ],
    "onPR": true,
    "healAfterGenerate": false
  },
  "heal": {
    "maxRetries": 2,
    "testCommand": "npm test"
  },
  "matrix": {
    "format": "json",
    "output": ".specguard/traceability.json"
  }
}
