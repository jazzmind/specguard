{
  "name": "specguard",
  "displayName": "SpecGuard",
  "description": "Living Specification QA agent — spec coverage, drift detection, test generation, and security analysis in your IDE.",
  "version": "0.1.20",
  "publisher": "specguard",
  "repository": {
    "type": "git",
    "url": "https://github.com/specguard/specguard"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Linters",
    "Other"
  ],
  "keywords": [
    "qa",
    "testing",
    "specifications",
    "cursor",
    "mcp"
  ],
  "activationEvents": [
    "workspaceContains:.specguard/config.json",
    "onCommand:specguard.init",
    "onView:specguard.coverageView",
    "onCommand:specguard.openDashboard",
    "onView:specguard-sidebar"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "specguard.init",
        "title": "SpecGuard: Initialize",
        "icon": "$(shield)"
      },
      {
        "command": "specguard.status",
        "title": "SpecGuard: Show Coverage",
        "icon": "$(checklist)"
      },
      {
        "command": "specguard.drift",
        "title": "SpecGuard: Check Code Drift",
        "icon": "$(warning)"
      },
      {
        "command": "specguard.generateTests",
        "title": "SpecGuard: Generate Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "specguard.runTests",
        "title": "SpecGuard: Run Tests",
        "icon": "$(play)"
      },
      {
        "command": "specguard.validateFunctional",
        "title": "SpecGuard: Validate (Functional)",
        "icon": "$(run-all)"
      },
      {
        "command": "specguard.validateFunctionalAll",
        "title": "SpecGuard: Validate — All tests",
        "icon": "$(run-all)"
      },
      {
        "command": "specguard.validateFunctionalIntegration",
        "title": "SpecGuard: Validate — Integration tests",
        "icon": "$(layers)"
      },
      {
        "command": "specguard.validateFunctionalE2E",
        "title": "SpecGuard: Validate — E2E tests",
        "icon": "$(browser)"
      },
      {
        "command": "specguard.qualityCheck",
        "title": "SpecGuard: Quality Check",
        "icon": "$(verified)"
      },
      {
        "command": "specguard.importSpec",
        "title": "SpecGuard: Import Spec",
        "icon": "$(arrow-down)"
      },
      {
        "command": "specguard.reverseGenerate",
        "title": "SpecGuard: Reverse Generate Specs",
        "icon": "$(wand)"
      },
      {
        "command": "specguard.gapAnalysis",
        "title": "SpecGuard: Gap Analysis",
        "icon": "$(search)"
      },
      {
        "command": "specguard.depsAudit",
        "title": "SpecGuard: Dependency Audit",
        "icon": "$(package)"
      },
      {
        "command": "specguard.runSast",
        "title": "SpecGuard: SAST Scan",
        "icon": "$(bug)"
      },
      {
        "command": "specguard.securityScan",
        "title": "SpecGuard: Security Scan (OWASP)",
        "icon": "$(shield)"
      },
      {
        "command": "specguard.generateSecurityTests",
        "title": "SpecGuard: Generate Security Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "specguard.matrix",
        "title": "SpecGuard: Traceability Matrix",
        "icon": "$(list-tree)"
      },
      {
        "command": "specguard.generateDocs",
        "title": "SpecGuard: Generate Docs",
        "icon": "$(file-text)"
      },
      {
        "command": "specguard.registerMcp",
        "title": "SpecGuard: Register MCP Server (Cursor)",
        "icon": "$(plug)"
      },
      {
        "command": "specguard.refreshCoverage",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "specguard.openDashboard",
        "title": "SpecGuard: Open Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "specguard.switchProject",
        "title": "SpecGuard: Switch Project",
        "icon": "$(folder-active)"
      },
      {
        "command": "specguard.updateProject",
        "title": "SpecGuard: Update Project Files",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "specguard.generateTests",
          "when": "resourceExtname == .md && resourcePath =~ /specs/",
          "group": "specguard@1"
        },
        {
          "command": "specguard.securityScan",
          "when": "resourceExtname == .md && resourcePath =~ /specs/",
          "group": "specguard@2"
        }
      ],
      "view/title": [
        {
          "command": "specguard.switchProject",
          "when": "view == specguard.coverageView",
          "group": "navigation@0"
        },
        {
          "command": "specguard.refreshCoverage",
          "when": "view == specguard.coverageView",
          "group": "navigation@1"
        },
        {
          "command": "specguard.openDashboard",
          "when": "view == specguard.coverageView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "specguard.importSpec",
          "when": "view == specguard.pipelinesView && viewItem == pipeline-action",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "specguard-sidebar",
          "title": "SpecGuard",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "specguard-sidebar": [
        {
          "id": "specguard.dashboardView",
          "name": "Dashboard",
          "icon": "$(graph)",
          "tooltip": "SpecGuard Dashboard",
          "description": "View coverage trends, run pipelines, and manage your Living Specs.",
          "type": "tree"
        },
        {
          "id": "specguard.coverageView",
          "name": "Coverage",
          "icon": "$(shield)",
          "tooltip": "SpecGuard Coverage",
          "description": "View per-app spec coverage and test counts.",
          "type": "tree"
        },
        {
          "id": "specguard.pipelinesView",
          "name": "Pipelines",
          "icon": "$(play-circle)",
          "tooltip": "SpecGuard Pipelines",
          "description": "View pipeline status and run pipelines.",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "specguard.dashboardView",
        "contents": "[Open Dashboard](command:specguard.openDashboard)\n[Switch Project](command:specguard.switchProject)\n[Update Project Files](command:specguard.updateProject)"
      },
      {
        "view": "specguard.coverageView",
        "contents": "No SpecGuard config found in this workspace.\n[Initialize SpecGuard](command:specguard.init)\nThis will scaffold .specguard/config.json and create your first specs.\n[Open Dashboard](command:specguard.openDashboard)"
      }
    ],
    "configuration": {
      "title": "SpecGuard",
      "properties": {
        "specguard.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to specguard CLI binary. Leave empty to use the version installed in the workspace."
        },
        "specguard.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh coverage when spec files change."
        },
        "specguard.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show spec coverage percentage in the status bar."
        },
        "specguard.autoDocs": {
          "type": "boolean",
          "default": false,
          "description": "Automatically regenerate documentation when a spec file changes (debounced 3s)."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "npm --prefix webview install && npm --prefix webview run build",
    "build:host": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap",
    "build:cli": "esbuild ../src/cli/index.ts --bundle --platform=node --format=cjs --outfile=dist/cli.js --sourcemap",
    "build": "npm run build:webview && npm run build:cli && npm run build:host",
    "watch": "npm run build:host -- --watch",
    "package": "vsce package",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry-run": "node scripts/release.mjs patch --dry-run",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22",
    "typescript": "^5.7",
    "esbuild": "^0.24",
    "@vscode/vsce": "^3",
    "vitest": "^3"
  }
}
